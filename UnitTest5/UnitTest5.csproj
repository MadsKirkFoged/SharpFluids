<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net470;net6.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
	  <LangVersion>12.0</LangVersion>
	  <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <!-- EngineeringUnits.Fast is net10.0 only and needs C# 14 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
	  <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EngineeringUnits.Fast" Version="2.2.149" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EngineeringUnits" Version="2.2.147" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpFluids\SharpFluids.csproj" />
  </ItemGroup>
</Project>